<%= turbo_frame_tag "meal_plans" do %>
  <section class="page-title">
    <h1>献立一覧</h1>
    <p>昼食・夕食を確認します。</p>
  </section>

  <% if @meal_plans.any? %>
    <% @meal_plans.group_by(&:meal_date).each do |date, plans| %>
      <section class="card">
        <div class="section-title">
          <h2><%= app_date(date) %></h2>
        </div>
        <% ["lunch", "dinner"].each do |meal_type| %>
          <% plan = plans.find { |item| item.meal_type == meal_type } %>
          <div class="meal-block">
            <div class="meal-head">
              <div class="meal-head-main">
                <span class="meal-label"><%= meal_type_label(meal_type) %></span>
                <% if plan&.person_tags&.any? %>
                  <span class="meal-tag-line"><%= plan.person_tags.map(&:name).join("、") %></span>
                <% end %>
              </div>
            </div>
            <% if plan %>
              <% plan.plan_dishes.ordered.each do |dish| %>
                <%= link_to edit_meal_plan_path(plan), class: "dish meal-edit-trigger", data: { turbo_frame: "_top" } do %>
                  <div class="dish-icon"><%= dish_icon(dish.name) %></div>
                  <div>
                    <h3><%= dish.name %></h3>
                    <% ingredients = dish.dish_ingredients.sort_by(&:id).map(&:name).reject(&:blank?) %>
                    <% if ingredients.any? %>
                      <p class="meal-dish-detail">
                        <span>食材</span>
                        <%= ingredients.join(", ") %>
                      </p>
                    <% end %>
                    <% if dish.memo.present? %>
                      <p class="meal-dish-detail">
                        <span>メモ</span>
                        <%= dish.memo %>
                      </p>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            <% else %>
              <p class="empty-state">未登録</p>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>
  <% else %>
    <p class="empty-state">献立はまだありません。</p>
  <% end %>
<% end %>
